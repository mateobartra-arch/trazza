*-firebase-adminsdk-*.json

# Config real de un tenant. La plantilla (public/core/trazza.config.js) sí se
# versiona; las copias por cliente con credenciales reales no.
clientes/*/trazza.config.js

node_modules/
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.DS_Store
Thumbs.db

